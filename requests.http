@host = http://localhost:3000

### logowanie ADMIN
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "{{adminPassword}}"
}

> {% client.global.set("adminToken", response.body.accessToken); %}

### logowanie USER wlasciciel (jan.kowalski, rezerwacja 2)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "jan.kowalski@example.com",
  "password": "{{userPassword}}"
}

> {%
  const token = response.body.accessToken;
  client.global.set("userToken", token);
  const last = token.charAt(token.length - 2) === "A" ? "B" : "A";
  client.global.set("badSignatureToken", token.slice(0, -2) + last + token.slice(-1));
%}

### logowanie USER obcy (anna.nowak)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "anna.nowak@example.com",
  "password": "{{userPassword}}"
}

> {% client.global.set("otherToken", response.body.accessToken); %}

### rejestracja
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "Jan.Nowicki@Example.com",
  "password": "bardzo-dlugie-haslo"
}

### rejestracja z rola ADMIN
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "hacker@example.com",
  "password": "bardzo-dlugie-haslo",
  "role": "ADMIN"
}

### rejestracja za krotkie haslo
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "krotkie@example.com",
  "password": "krotkie"
}

### rejestracja duplikat emaila (inna wielkosc liter)
